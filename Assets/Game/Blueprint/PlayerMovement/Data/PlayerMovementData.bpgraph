    - rid: 2881251991724752941
      type: {class: BlueprintVisualGraph, ns: BlueprintSystem.Editor, asm: Assembly-CSharp-Editor}
      data:
        SourceBlueprintAssetPath: Assets/Game/Blueprint/PlayerMovement/Data/PlayerMovementData.blueprint.json
        SchemaVersion: 0.1
        BlueprintName: PlayerMovementData
        Category: PlayerMovement/Data
        Description: Configuration and runtime state for local player ground movement.
        Variables:
        - Id: var_be15716cc41240eabd26e08dd2249dfd
          Name: move_speed
          Type: float
          HasDefaultValue: 1
          JsonDefaultValue: 1
          Scope: runtime
          Exposed: 1
          Persistent: 1
          Description: World units per second for base ground movement.
        - Id: var_56be4a011cca47c3ad84623e4b8d8d3a
          Name: input_dead_zone
          Type: float
          HasDefaultValue: 1
          JsonDefaultValue: 0.1
          Scope: runtime
          Exposed: 1
          Persistent: 1
          Description: Minimum Player/Move vector length before movement starts.
        - Id: var_7e08cd9b840e42cc91eade32c1f64954
          Name: rotate_to_move_direction
          Type: bool
          HasDefaultValue: 1
          JsonDefaultValue: false
          Scope: runtime
          Exposed: 1
          Persistent: 1
          Description: When true, the player instantly faces the current movement
            direction.
        - Id: var_3f231caf82fe45548454d6888fbfd3fa
          Name: turn_speed
          Type: float
          HasDefaultValue: 1
          JsonDefaultValue: 720
          Scope: runtime
          Exposed: 1
          Persistent: 1
          Description: Reserved turn speed in degrees per second for future smoothed
            rotation.
        - Id: var_8070b1902ade4edd899d8f8da20d6f91
          Name: current_input
          Type: Vector2
          HasDefaultValue: 1
          JsonDefaultValue: '[0,0]'
          Scope: runtime
          Exposed: 1
          Persistent: 0
          Description: Latest accepted Player/Move input vector after dead-zone filtering.
        - Id: var_f2ceac2debdf481785769cc8249dd602
          Name: current_move_direction
          Type: Vector3
          HasDefaultValue: 1
          JsonDefaultValue: '[0,0,0]'
          Scope: runtime
          Exposed: 1
          Persistent: 0
          Description: Normalized world-space movement direction on the XZ plane.
        - Id: var_51dcb3e3837048a5b616d4c45632e79b
          Name: is_moving
          Type: bool
          HasDefaultValue: 1
          JsonDefaultValue: false
          Scope: runtime
          Exposed: 1
          Persistent: 0
          Description: True while the accepted input vector is outside the dead zone.
        Bindings: []
        Components: []
