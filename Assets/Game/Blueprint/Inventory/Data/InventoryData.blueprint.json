    {
      "id": "var_save_version",
      "name": "save_version",
      "type": "int",
      "defaultValue": 1,
      "scope": "runtime",
      "exposed": true,
      "persistent": true,
      "description": "Reserved save migration version. Existing BlueprintSystem has metadata only; no file IO node is available."
    },
    {
      "id": "var_inventory_capacity",
      "name": "inventory_capacity",
      "type": "int",
      "defaultValue": 40,
      "scope": "runtime",
      "exposed": true,
      "persistent": true,
      "description": "Fixed MVP slot count."
    },
    {
      "id": "var_screen_open",
      "name": "screen_open",
      "type": "bool",
      "defaultValue": false,
      "scope": "runtime",
      "exposed": true,
      "persistent": true,
      "description": "Inventory screen visible state."
