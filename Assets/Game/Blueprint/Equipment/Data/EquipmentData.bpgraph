      data:
        SourceBlueprintAssetPath: Assets/Game/Blueprint/Equipment/Data/EquipmentData.blueprint.json
        SchemaVersion: 0.1
        BlueprintName: EquipmentData
        Category: Equipment/Data
        Description: Runtime source of truth for equipment slots, character stats,
          equipment config, and selected equipment detail.
        Variables:
        - Id: var_screen_open
          Name: screen_open
          Type: bool
          HasDefaultValue: 1
          JsonDefaultValue: false
          Scope: runtime
          Exposed: 1
          Persistent: 1
          Description: Equipment screen visibility state.
        - Id: var_player_level
          Name: player_level
          Type: int
          HasDefaultValue: 1
          JsonDefaultValue: 10
          Scope: runtime
          Exposed: 1
          Persistent: 1
          Description: MVP player level used by equip checks.
        - Id: var_player_class
          Name: player_class
          Type: string
          HasDefaultValue: 1
          JsonDefaultValue: '"Warrior"'
          Scope: runtime
          Exposed: 1
          Persistent: 1
          Description: MVP player class used by equip checks.
        - Id: var_base_attack
