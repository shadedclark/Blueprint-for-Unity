{
  "schemaVersion": "0.1",
  "typeId": "VehicleRoad.FindNearestLane",
  "title": "VehicleRoad Find Nearest Lane",
  "category": "VehicleRoads",
  "description": "Finds the closest open lane for an agent mask.",
  "executor": "VehicleRoad.FindNearestLane",
  "inputs": [
    { "id": "target", "kind": "value", "type": "Binding<VehicleRoadSubsystem>", "required": true, "source": "propertyOrConnection" },
    { "id": "position", "kind": "value", "type": "Vector3", "required": true, "source": "propertyOrConnection" },
    { "id": "heading", "kind": "value", "type": "Vector3", "required": true, "source": "propertyOrConnection" },
    { "id": "agentMask", "kind": "value", "type": "RoadAgentMask", "required": false, "source": "propertyOrConnection" },
    { "id": "maxDistance", "kind": "value", "type": "float", "required": false, "source": "propertyOrConnection" },
    { "id": "maxHeightDifference", "kind": "value", "type": "float", "required": false, "source": "propertyOrConnection" }
  ],
  "outputs": [
    { "id": "found", "kind": "value", "type": "bool" },
    { "id": "laneId", "kind": "value", "type": "string" },
    { "id": "position", "kind": "value", "type": "Vector3" },
    { "id": "forward", "kind": "value", "type": "Vector3" },
    { "id": "up", "kind": "value", "type": "Vector3" },
    { "id": "distanceAlongLane", "kind": "value", "type": "float" },
    { "id": "distanceToLane", "kind": "value", "type": "float" }
  ],
  "properties": [
    { "id": "target", "required": true, "type": "Binding<VehicleRoadSubsystem>" },
    { "id": "position", "required": false, "type": "Vector3", "defaultValue": [0, 0, 0] },
    { "id": "heading", "required": false, "type": "Vector3", "defaultValue": [0, 0, 1] },
    { "id": "agentMask", "required": false, "type": "RoadAgentMask", "defaultValue": "MotorVehicles" },
    { "id": "maxDistance", "required": false, "type": "float", "defaultValue": 0 },
    { "id": "maxHeightDifference", "required": false, "type": "float", "defaultValue": 0 }
  ]
}
