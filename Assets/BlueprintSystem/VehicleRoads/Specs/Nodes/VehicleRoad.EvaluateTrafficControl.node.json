{
  "schemaVersion": "0.1",
  "typeId": "VehicleRoad.EvaluateTrafficControl",
  "title": "VehicleRoad Evaluate Traffic Control",
  "category": "VehicleRoads",
  "description": "Evaluates stop, queue, signal, lead vehicle, and lane-change constraints.",
  "executor": "VehicleRoad.EvaluateTrafficControl",
  "inputs": [
    { "id": "execIn", "kind": "exec" },
    { "id": "target", "kind": "value", "type": "Binding<VehicleRoadSubsystem>", "required": true, "source": "propertyOrConnection" },
    { "id": "vehicleId", "kind": "value", "type": "string", "required": true, "source": "propertyOrConnection" },
    { "id": "laneId", "kind": "value", "type": "string", "required": true, "source": "propertyOrConnection" },
    { "id": "agentMask", "kind": "value", "type": "RoadAgentMask", "required": false, "source": "propertyOrConnection" },
    { "id": "distanceAlongLane", "kind": "value", "type": "float", "required": true, "source": "propertyOrConnection" },
    { "id": "speed", "kind": "value", "type": "float", "required": false, "source": "propertyOrConnection" },
    { "id": "vehicleLength", "kind": "value", "type": "float", "required": false, "source": "propertyOrConnection" },
    { "id": "routeLaneIds", "kind": "value", "type": "Array<string>", "required": false, "source": "propertyOrConnection" }
  ],
  "outputs": [
    { "id": "execOut", "kind": "exec" },
    { "id": "hasConstraint", "kind": "value", "type": "bool" },
    { "id": "stopReason", "kind": "value", "type": "VehicleRoadStopReason" },
    { "id": "passageStatus", "kind": "value", "type": "VehicleRoadPassageStatus" },
    { "id": "signalState", "kind": "value", "type": "VehicleRoadSignalState" },
    { "id": "junctionId", "kind": "value", "type": "string" },
    { "id": "connectorLaneId", "kind": "value", "type": "string" },
    { "id": "connectionId", "kind": "value", "type": "string" },
    { "id": "queueIndex", "kind": "value", "type": "int" },
    { "id": "distanceToStopLine", "kind": "value", "type": "float" },
    { "id": "targetSpeedLimit", "kind": "value", "type": "float" },
    { "id": "hasStopPosition", "kind": "value", "type": "bool" },
    { "id": "stopPosition", "kind": "value", "type": "Vector3" },
    { "id": "leadVehicleId", "kind": "value", "type": "string" },
    { "id": "leadVehicleLaneId", "kind": "value", "type": "string" },
    { "id": "leadVehicleDistance", "kind": "value", "type": "float" },
    { "id": "leadVehicleSpeed", "kind": "value", "type": "float" },
    { "id": "leadVehicleLength", "kind": "value", "type": "float" },
    { "id": "laneChangeStatus", "kind": "value", "type": "VehicleRoadLaneChangeStatus" },
    { "id": "laneChangeTargetLaneId", "kind": "value", "type": "string" },
    { "id": "hasLaneChangeTargetPoint", "kind": "value", "type": "bool" },
    { "id": "laneChangeTargetPoint", "kind": "value", "type": "Vector3" },
    { "id": "failureReason", "kind": "value", "type": "string" }
  ],
  "properties": [
    { "id": "target", "required": true, "type": "Binding<VehicleRoadSubsystem>" },
    { "id": "vehicleId", "required": false, "type": "string", "defaultValue": "" },
    { "id": "laneId", "required": false, "type": "string", "defaultValue": "" },
    { "id": "agentMask", "required": false, "type": "RoadAgentMask", "defaultValue": "MotorVehicles" },
    { "id": "distanceAlongLane", "required": false, "type": "float", "defaultValue": 0 },
    { "id": "speed", "required": false, "type": "float", "defaultValue": 0 },
    { "id": "vehicleLength", "required": false, "type": "float", "defaultValue": 0 },
    { "id": "routeLaneIds", "required": false, "type": "Array<string>", "defaultValue": [] }
  ]
}
