{
  "schemaVersion": "0.1",
  "typeId": "VehicleRoad.ComputeFollowerControl",
  "title": "VehicleRoad Compute Follower Control",
  "category": "VehicleRoads",
  "description": "Computes follower steering and speed outputs without moving the vehicle.",
  "executor": "VehicleRoad.ComputeFollowerControl",
  "inputs": [
    { "id": "execIn", "kind": "exec" },
    { "id": "target", "kind": "value", "type": "Binding<VehicleLaneFollower>", "required": true, "source": "propertyOrConnection" },
    { "id": "vehicleId", "kind": "value", "type": "string", "required": false, "source": "propertyOrConnection" },
    { "id": "position", "kind": "value", "type": "Vector3", "required": true, "source": "propertyOrConnection" },
    { "id": "forward", "kind": "value", "type": "Vector3", "required": true, "source": "propertyOrConnection" },
    { "id": "speed", "kind": "value", "type": "float", "required": false, "source": "propertyOrConnection" },
    { "id": "wheelBase", "kind": "value", "type": "float", "required": false, "source": "propertyOrConnection" },
    { "id": "vehicleLength", "kind": "value", "type": "float", "required": false, "source": "propertyOrConnection" },
    { "id": "agentMask", "kind": "value", "type": "RoadAgentMask", "required": false, "source": "propertyOrConnection" },
    { "id": "leadVehicleDistance", "kind": "value", "type": "float", "required": false, "source": "propertyOrConnection" },
    { "id": "leadVehicleSpeed", "kind": "value", "type": "float", "required": false, "source": "propertyOrConnection" },
    { "id": "requestLaneChange", "kind": "value", "type": "bool", "required": false, "source": "propertyOrConnection" },
    { "id": "requestedLaneChangeSide", "kind": "value", "type": "RoadLaneAdjacentSide", "required": false, "source": "propertyOrConnection" }
  ],
  "outputs": [
    { "id": "execOut", "kind": "exec" },
    { "id": "valid", "kind": "value", "type": "bool" },
    { "id": "currentLaneId", "kind": "value", "type": "string" },
    { "id": "distanceAlongLane", "kind": "value", "type": "float" },
    { "id": "targetSteeringAngle", "kind": "value", "type": "float" },
    { "id": "targetSpeed", "kind": "value", "type": "float" },
    { "id": "lookAheadPoint", "kind": "value", "type": "Vector3" },
    { "id": "recoveryMode", "kind": "value", "type": "VehicleLaneRecoveryMode" },
    { "id": "recoveryPosition", "kind": "value", "type": "Vector3" },
    { "id": "lateralError", "kind": "value", "type": "float" },
    { "id": "stopReason", "kind": "value", "type": "VehicleRoadStopReason" },
    { "id": "passageStatus", "kind": "value", "type": "VehicleRoadPassageStatus" },
    { "id": "signalState", "kind": "value", "type": "VehicleRoadSignalState" },
    { "id": "hasStopPoint", "kind": "value", "type": "bool" },
    { "id": "stopPoint", "kind": "value", "type": "Vector3" },
    { "id": "distanceToStopLine", "kind": "value", "type": "float" },
    { "id": "queueIndex", "kind": "value", "type": "int" },
    { "id": "junctionId", "kind": "value", "type": "string" },
    { "id": "connectorLaneId", "kind": "value", "type": "string" },
    { "id": "laneChangeStatus", "kind": "value", "type": "VehicleRoadLaneChangeStatus" },
    { "id": "laneChangeTargetLaneId", "kind": "value", "type": "string" }
  ],
  "properties": [
    { "id": "target", "required": true, "type": "Binding<VehicleLaneFollower>" },
    { "id": "vehicleId", "required": false, "type": "string", "defaultValue": "" },
    { "id": "position", "required": false, "type": "Vector3", "defaultValue": [0, 0, 0] },
    { "id": "forward", "required": false, "type": "Vector3", "defaultValue": [0, 0, 1] },
    { "id": "speed", "required": false, "type": "float", "defaultValue": 0 },
    { "id": "wheelBase", "required": false, "type": "float", "defaultValue": 2.7 },
    { "id": "vehicleLength", "required": false, "type": "float", "defaultValue": 4.5 },
    { "id": "agentMask", "required": false, "type": "RoadAgentMask", "defaultValue": "MotorVehicles" },
    { "id": "leadVehicleDistance", "required": false, "type": "float", "defaultValue": 0 },
    { "id": "leadVehicleSpeed", "required": false, "type": "float", "defaultValue": 0 },
    { "id": "requestLaneChange", "required": false, "type": "bool", "defaultValue": false },
    { "id": "requestedLaneChangeSide", "required": false, "type": "RoadLaneAdjacentSide", "defaultValue": "Right" }
  ]
}
