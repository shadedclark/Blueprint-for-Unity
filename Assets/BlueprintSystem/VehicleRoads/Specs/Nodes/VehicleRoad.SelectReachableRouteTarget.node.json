{
  "schemaVersion": "0.1",
  "typeId": "VehicleRoad.SelectReachableRouteTarget",
  "title": "VehicleRoad Select Reachable Route Target",
  "category": "VehicleRoads",
  "description": "Selects a reachable destination lane from supplied or automatic candidates and returns the route.",
  "executor": "VehicleRoad.SelectReachableRouteTarget",
  "inputs": [
    { "id": "execIn", "kind": "exec" },
    { "id": "target", "kind": "value", "type": "Binding<VehicleRoadSubsystem>", "required": true, "source": "propertyOrConnection" },
    { "id": "currentLaneId", "kind": "value", "type": "string", "required": true, "source": "propertyOrConnection" },
    { "id": "agentMask", "kind": "value", "type": "RoadAgentMask", "required": false, "source": "propertyOrConnection" },
    { "id": "candidateLaneIds", "kind": "value", "type": "Array<string>", "required": false, "source": "propertyOrConnection" },
    { "id": "selectionMode", "kind": "value", "type": "VehicleRoadRouteTargetSelectionMode", "required": false, "source": "propertyOrConnection" },
    { "id": "previousIndex", "kind": "value", "type": "int", "required": false, "source": "propertyOrConnection" },
    { "id": "minimumRouteCost", "kind": "value", "type": "float", "required": false, "source": "propertyOrConnection" },
    { "id": "allowSameLane", "kind": "value", "type": "bool", "required": false, "source": "propertyOrConnection" },
    { "id": "excludeConnectors", "kind": "value", "type": "bool", "required": false, "source": "propertyOrConnection" }
  ],
  "outputs": [
    { "id": "execOut", "kind": "exec" },
    { "id": "success", "kind": "value", "type": "bool" },
    { "id": "destinationLaneId", "kind": "value", "type": "string" },
    { "id": "selectedIndex", "kind": "value", "type": "int" },
    { "id": "routeLaneIds", "kind": "value", "type": "Array<string>" },
    { "id": "totalCost", "kind": "value", "type": "float" },
    { "id": "failureReason", "kind": "value", "type": "string" }
  ],
  "properties": [
    { "id": "target", "required": true, "type": "Binding<VehicleRoadSubsystem>" },
    { "id": "currentLaneId", "required": false, "type": "string", "defaultValue": "" },
    { "id": "agentMask", "required": false, "type": "RoadAgentMask", "defaultValue": "Car" },
    { "id": "candidateLaneIds", "required": false, "type": "Array<string>", "defaultValue": [] },
    { "id": "selectionMode", "required": false, "type": "VehicleRoadRouteTargetSelectionMode", "defaultValue": "Random" },
    { "id": "previousIndex", "required": false, "type": "int", "defaultValue": -1 },
    { "id": "minimumRouteCost", "required": false, "type": "float", "defaultValue": 0.001 },
    { "id": "allowSameLane", "required": false, "type": "bool", "defaultValue": false },
    { "id": "excludeConnectors", "required": false, "type": "bool", "defaultValue": true }
  ]
}
