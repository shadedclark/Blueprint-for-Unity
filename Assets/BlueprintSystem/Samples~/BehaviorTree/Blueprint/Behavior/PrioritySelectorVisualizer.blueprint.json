  "edges": [
    {
      "from": "event_start.execOut",
      "to": "delay_alert_request.execIn"
    },
    {
      "from": "delay_alert_request.execOut",
      "to": "set_alert_requested.execIn"
    },
    {
      "from": "event_idle_selected.execOut",
      "to": "set_priority_idle.execIn"
    },
    {
      "from": "event_alert_selected.execOut",
      "to": "set_priority_alert.execIn"
    },
    {
      "from": "event_tick.execOut",
      "to": "sequence_tick.execIn"
    },
    {
      "from": "sequence_tick.then0",
      "to": "branch_idle.execIn"
    },
    {
      "from": "sequence_tick.then1",
      "to": "branch_alert.execIn"
    },
    {
      "from": "sequence_tick.then2",
      "to": "set_status_label.execIn"
    },
    {
      "from": "get_priority.value",
      "to": "compare_idle.left"
    },
    {
      "from": "compare_idle.result",
      "to": "branch_idle.condition"
    },
    {
      "from": "branch_idle.true",
      "to": "set_idle_active_color.execIn"
    },
    {
      "from": "set_idle_active_color.execOut",
      "to": "set_idle_active_scale.execIn"
    },
    {
      "from": "branch_idle.false",
      "to": "set_idle_inactive_color.execIn"
    },
    {
      "from": "set_idle_inactive_color.execOut",
      "to": "set_idle_inactive_scale.execIn"
    },
    {
      "from": "get_priority.value",
      "to": "compare_alert.left"
    },
    {
      "from": "compare_alert.result",
      "to": "branch_alert.condition"
    },
    {
      "from": "branch_alert.true",
      "to": "set_alert_active_color.execIn"
    },
    {
      "from": "set_alert_active_color.execOut",
      "to": "set_alert_active_scale.execIn"
    },
    {
      "from": "branch_alert.false",
      "to": "set_alert_inactive_color.execIn"
    },
    {
      "from": "set_alert_inactive_color.execOut",
      "to": "set_alert_inactive_scale.execIn"
    },
    {
      "from": "get_priority.value",
      "to": "set_status_label.value"
    }
  ]
