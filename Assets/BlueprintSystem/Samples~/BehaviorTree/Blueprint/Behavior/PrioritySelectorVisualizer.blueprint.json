{
  "schemaVersion": "0.1",
  "name": "PrioritySelectorVisualizer",
  "category": "BehaviorTree/Demo",
  "description": "Visualizes the priority selector demo and requests AlertMode after a startup delay.",
  "variables": [
    {
      "id": "var_a5741060e608476596c485aec0298b66",
      "name": "selected_priority",
      "type": "string",
      "defaultValue": "None",
      "scope": "runtime",
      "exposed": true,
      "description": "Latest priority branch reported by the behavior tree."
    },
    {
      "id": "var_b6109be73869404d994ae29a2aa6dc9b",
      "name": "alert_requested",
      "type": "bool",
      "defaultValue": false,
      "scope": "runtime",
      "exposed": true,
      "description": "Set true after two seconds; the behavior tree copies this to AlertMode."
    }
