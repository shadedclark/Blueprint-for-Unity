    - rid: 791859580787228874
      type: {class: BehaviorTreeVisualGraph, ns: BlueprintSystem.Editor, asm: BlueprintSystem.BehaviorTree.Editor}
      data:
        SourceBehaviorTreeAssetPath: Assets/BlueprintSystem/Samples~/BehaviorTree/AI/Behavior/ParallelWaitAllExample.btree.json
        SchemaVersion: 0.1
        BehaviorTreeName: ParallelWaitAllExample
        Category: AI/Examples
        Description: 'Composite node example: Parallel ticks both branches and succeeds
          only after every branch completes.'
        RootNodeId: root
        Blackboard:
        - Name: LeftDone
          Type: bool
          HasDefaultValue: 1
          DefaultValueJson: false
          Exposed: 1
          Persistent: 0
          Description: Set true by the shorter parallel branch.
        - Name: RightDone
          Type: bool
          HasDefaultValue: 1
          DefaultValueJson: false
          Exposed: 1
          Persistent: 0
          Description: Set true by the longer parallel branch.
        Nodes:
        - Id: root
          TypeId: BT.Root
          X: 0
          Y: 0
          Children:
          - parallel_wait_for_all
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: parallel_wait_for_all
          TypeId: BT.Parallel
          X: 0
          Y: 160
          Children:
          - left_sequence
          - right_sequence
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: left_sequence
          TypeId: BT.Sequence
          X: -180
          Y: 320
          Children:
          - left_wait_short
          - set_left_done
          - log_left_done
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: left_wait_short
          TypeId: BT.Wait
          X: -300
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{"duration":0.35}'
        - Id: set_left_done
          TypeId: BT.SetBlackboard
          X: -140
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings:
          - InputId: key
            BlackboardKey: LeftDone
          PropertiesJson: '{"key":"LeftDone","value":true}'
        - Id: log_left_done
          TypeId: BT.Log
          X: 20
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{"message":"Parallel left branch completed."}'
        - Id: right_sequence
          TypeId: BT.Sequence
          X: 260
          Y: 320
          Children:
          - right_wait_long
          - set_right_done
          - log_right_done
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: right_wait_long
          TypeId: BT.Wait
          X: 140
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{"duration":0.9}'
        - Id: set_right_done
          TypeId: BT.SetBlackboard
          X: 300
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings:
          - InputId: key
            BlackboardKey: RightDone
          PropertiesJson: '{"key":"RightDone","value":true}'
        - Id: log_right_done
          TypeId: BT.Log
          X: 460
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{"message":"Parallel right branch completed; the composite
            can now succeed."}'
        Decorators: []
        Services: []
