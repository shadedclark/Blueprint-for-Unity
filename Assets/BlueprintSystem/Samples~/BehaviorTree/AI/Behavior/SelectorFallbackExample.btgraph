        - rid: 791859580787228798
        - rid: 791859580787228799
        m_Title: 
    - rid: 791859580787228774
      type: {class: BehaviorTreeVisualGraph, ns: BlueprintSystem.Editor, asm: BlueprintSystem.BehaviorTree.Editor}
      data:
        SourceBehaviorTreeAssetPath: Assets/BlueprintSystem/Samples~/BehaviorTree/AI/Behavior/SelectorFallbackExample.btree.json
        SchemaVersion: 0.1
        BehaviorTreeName: SelectorFallbackExample
        Category: AI/Examples
        Description: 'Composite node example: Selector tries a guarded high-priority
          branch, then falls back to patrol.'
        RootNodeId: root
        Blackboard:
        - Name: EnemyVisible
          Type: bool
          HasDefaultValue: 1
          DefaultValueJson: false
          Exposed: 1
          Persistent: 0
          Description: Set true to let the selector choose the engage branch.
        - Name: SelectedBranch
          Type: string
          HasDefaultValue: 1
          DefaultValueJson: '"None"'
          Exposed: 1
          Persistent: 0
          Description: Records which selector branch succeeded.
        Nodes:
        - Id: root
          TypeId: BT.Root
          X: 0
          Y: 0
          Children:
          - selector_choose_behavior
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: selector_choose_behavior
          TypeId: BT.Selector
          X: 0
          Y: 160
          Children:
          - engage_sequence
          - patrol_fallback_sequence
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: engage_sequence
          TypeId: BT.Sequence
          X: -180
          Y: 320
          Children:
          - set_branch_engage
          - log_engage
          Decorators:
          - condition_enemy_visible
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: set_branch_engage
          TypeId: BT.SetBlackboard
          X: -260
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings:
          - InputId: key
            BlackboardKey: SelectedBranch
          PropertiesJson: '{"key":"SelectedBranch","value":"Engage"}'
        - Id: log_engage
          TypeId: BT.Log
          X: -100
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{"message":"Selector chose the guarded engage branch."}'
        - Id: patrol_fallback_sequence
          TypeId: BT.Sequence
          X: 220
          Y: 320
          Children:
          - set_branch_patrol
          - log_patrol
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: set_branch_patrol
          TypeId: BT.SetBlackboard
          X: 140
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings:
          - InputId: key
            BlackboardKey: SelectedBranch
          PropertiesJson: '{"key":"SelectedBranch","value":"PatrolFallback"}'
        - Id: log_patrol
          TypeId: BT.Log
          X: 300
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{"message":"Selector fell back to patrol because EnemyVisible
            is false."}'
        Decorators:
        - Id: condition_enemy_visible
          TypeId: BT.CompareBool
          InputBindings:
          - InputId: value
            BlackboardKey: EnemyVisible
          PropertiesJson: '{"operator":"Equals","expected":true}'
        Services: []
