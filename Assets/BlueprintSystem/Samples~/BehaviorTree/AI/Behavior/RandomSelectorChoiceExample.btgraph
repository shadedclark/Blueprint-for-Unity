    - rid: 791859580787228982
      type: {class: BehaviorTreeVisualGraph, ns: BlueprintSystem.Editor, asm: BlueprintSystem.BehaviorTree.Editor}
      data:
        SourceBehaviorTreeAssetPath: Assets/BlueprintSystem/Samples~/BehaviorTree/AI/Behavior/RandomSelectorChoiceExample.btree.json
        SchemaVersion: 0.1
        BehaviorTreeName: RandomSelectorChoiceExample
        Category: AI/Examples
        Description: 'Composite node example: RandomSelector shuffles branches, skips
          failed conditions, and succeeds on the first available choice.'
        RootNodeId: root
        Blackboard:
        - Name: AllowRareBranch
          Type: bool
          HasDefaultValue: 1
          DefaultValueJson: false
          Exposed: 1
          Persistent: 0
          Description: Set true to allow the rare random branch.
        - Name: RandomChoice
          Type: string
          HasDefaultValue: 1
          DefaultValueJson: '"None"'
          Exposed: 1
          Persistent: 0
          Description: Records which random branch succeeded.
        Nodes:
        - Id: root
          TypeId: BT.Root
          X: 0
          Y: 0
          Children:
          - random_selector_choose_action
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: random_selector_choose_action
          TypeId: BT.RandomSelector
          X: 0
          Y: 160
          Children:
          - rare_sequence
          - scout_sequence
          - flank_sequence
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: rare_sequence
          TypeId: BT.Sequence
          X: -320
          Y: 320
          Children:
          - set_choice_rare
          - log_rare_choice
          Decorators:
          - condition_allow_rare_branch
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: set_choice_rare
          TypeId: BT.SetBlackboard
          X: -400
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings:
          - InputId: key
            BlackboardKey: RandomChoice
          PropertiesJson: '{"key":"RandomChoice","value":"Rare"}'
        - Id: log_rare_choice
          TypeId: BT.Log
          X: -240
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{"message":"RandomSelector picked the rare branch."}'
        - Id: scout_sequence
          TypeId: BT.Sequence
          X: 0
          Y: 320
          Children:
          - set_choice_scout
          - log_scout_choice
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: set_choice_scout
          TypeId: BT.SetBlackboard
          X: -80
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings:
          - InputId: key
            BlackboardKey: RandomChoice
          PropertiesJson: '{"key":"RandomChoice","value":"Scout"}'
        - Id: log_scout_choice
          TypeId: BT.Log
          X: 80
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{"message":"RandomSelector picked the scout branch."}'
        - Id: flank_sequence
          TypeId: BT.Sequence
          X: 320
          Y: 320
          Children:
          - set_choice_flank
          - log_flank_choice
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: set_choice_flank
          TypeId: BT.SetBlackboard
          X: 240
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings:
          - InputId: key
            BlackboardKey: RandomChoice
          PropertiesJson: '{"key":"RandomChoice","value":"Flank"}'
        - Id: log_flank_choice
          TypeId: BT.Log
          X: 400
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{"message":"RandomSelector picked the flank branch."}'
        Decorators:
        - Id: condition_allow_rare_branch
          TypeId: BT.CompareBool
          InputBindings:
          - InputId: value
            BlackboardKey: AllowRareBranch
          PropertiesJson: '{"operator":"Equals","expected":true}'
        Services: []
