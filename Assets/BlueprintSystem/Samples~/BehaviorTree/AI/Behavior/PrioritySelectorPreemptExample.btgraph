        - rid: 791859580787229140
        m_Title: 
    - rid: 791859580787229113
      type: {class: BehaviorTreeVisualGraph, ns: BlueprintSystem.Editor, asm: BlueprintSystem.BehaviorTree.Editor}
      data:
        SourceBehaviorTreeAssetPath: Assets/BlueprintSystem/Samples~/BehaviorTree/AI/Behavior/PrioritySelectorPreemptExample.btree.json
        SchemaVersion: 0.1
        BehaviorTreeName: PrioritySelectorPreemptExample
        Category: AI/Examples
        Description: 'Composite node example: PrioritySelector rechecks higher-priority
          children each tick so AlertMode can preempt idle work.'
        RootNodeId: root
        Blackboard:
        - Name: AlertMode
          Type: bool
          HasDefaultValue: 1
          DefaultValueJson: false
          Exposed: 1
          Persistent: 0
          Description: Set true at runtime to let the alert branch preempt idle.
        - Name: SelectedPriority
          Type: string
          HasDefaultValue: 1
          DefaultValueJson: '"None"'
          Exposed: 1
          Persistent: 0
          Description: Records which priority branch completed.
        Nodes:
        - Id: root
          TypeId: BT.Root
          X: 0
          Y: 0
          Children:
          - priority_selector_alert_or_idle
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: priority_selector_alert_or_idle
          TypeId: BT.PrioritySelector
          X: 0
          Y: 160
          Children:
          - alert_sequence
          - idle_sequence
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: alert_sequence
          TypeId: BT.Sequence
          X: -180
          Y: 320
          Children:
          - set_priority_alert
          - log_alert
          Decorators:
          - condition_alert_mode
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: set_priority_alert
          TypeId: BT.SetBlackboard
          X: -260
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings:
          - InputId: key
            BlackboardKey: SelectedPriority
          PropertiesJson: '{"key":"SelectedPriority","value":"Alert"}'
        - Id: log_alert
          TypeId: BT.Log
          X: -100
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{"message":"PrioritySelector selected the high-priority
            alert branch."}'
        - Id: idle_sequence
          TypeId: BT.Sequence
          X: 220
          Y: 320
          Children:
          - idle_wait
          - set_priority_idle
          - log_idle
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: idle_wait
          TypeId: BT.Wait
          X: 100
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{"duration":8}'
        - Id: set_priority_idle
          TypeId: BT.SetBlackboard
          X: 260
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings:
          - InputId: key
            BlackboardKey: SelectedPriority
          PropertiesJson: '{"key":"SelectedPriority","value":"Idle"}'
        - Id: log_idle
          TypeId: BT.Log
          X: 420
          Y: 480
          Children: []
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{"message":"PrioritySelector stayed on idle because AlertMode
            is false."}'
        Decorators:
        - Id: condition_alert_mode
          TypeId: BT.CompareBool
          InputBindings:
          - InputId: value
            BlackboardKey: AlertMode
          PropertiesJson: '{"operator":"Equals","expected":true}'
        Services: []
