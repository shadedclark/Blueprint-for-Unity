      data:
        SourceBehaviorTreeAssetPath: Assets/Game/Blueprint/BehaviorTreePatrol/Behavior/CapsuleFixedRoutePatrol.btree.json
        SchemaVersion: 0.1
        BehaviorTreeName: CapsuleFixedRoutePatrol
        Category: AI/Examples
        Description: 'Behavior tree demo: a capsule patrols a fixed four-point route
          in the current scene.'
        RootNodeId: root
        Blackboard:
        - Name: PatrolPoint
          Type: Vector3
          HasDefaultValue: 1
          DefaultValueJson: '[-3,0.5,-4]'
          Exposed: 1
          Persistent: 0
          Description: Current route destination for the patrol capsule.
        Nodes:
        - Id: root
          TypeId: BT.Root
          X: 0
          Y: 0
          Children:
          - patrol_sequence
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: patrol_sequence
          TypeId: BT.Sequence
          X: 0
          Y: 160
          Children:
          - set_point_01
          - turn_to_point_01
          - move_to_point_01
          - wait_at_point_01
          - set_point_02
          - turn_to_point_02
          - move_to_point_02
          - wait_at_point_02
          - set_point_03
          - turn_to_point_03
          - move_to_point_03
          - wait_at_point_03
          - set_point_04
          - turn_to_point_04
          - move_to_point_04
          - wait_at_point_04
          Decorators: []
          Services: []
          InputBindings: []
          PropertiesJson: '{}'
        - Id: set_point_01
          TypeId: BT.SetBlackboard
          X: -480
          Y: 320
          Children: []
          Decorators: []
          Services: []
          InputBindings:
          - InputId: key
            BlackboardKey: PatrolPoint
          PropertiesJson: '{"key":"PatrolPoint","value":[-3,0.5,-4]}'
        - Id: turn_to_point_01
          TypeId: BT.RotateTo
          X: -320
          Y: 320
          Children: []
          Decorators: []
          Services: []
          InputBindings:
          - InputId: target
            BlackboardKey: PatrolPoint
          PropertiesJson: '{"angleTolerance":3,"rotationSpeed":420,"ignoreY":true}'
