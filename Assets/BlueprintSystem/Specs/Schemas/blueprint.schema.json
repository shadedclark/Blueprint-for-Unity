{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blueprint Source",
  "type": "object",
  "required": ["schemaVersion", "name", "nodes", "edges"],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "bindings": {
      "type": "array"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "defaultValue": {},
        "scope": {
          "type": "string"
        },
        "exposed": {
          "type": "boolean"
        },
        "persistent": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "component": {
      "type": "object",
      "required": ["name", "blueprint"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "blueprint": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "typeId"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "typeId": {
          "type": "string"
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "properties": {
          "type": "object"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*\\.[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*\\.[a-zA-Z_][a-zA-Z0-9_]*$"
        }
      }
    }
  }
}
