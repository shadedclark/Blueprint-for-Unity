{
  "schemaVersion": "0.1",
  "typeId": "Persistence.Save",
  "title": "Save Persistent Variables",
  "category": "Persistence",
  "description": "Immediately saves persistent variables for the current BlueprintRunner.",
  "executor": "Persistence.Save",
  "inputs": [
    { "id": "execIn", "kind": "exec" },
    { "id": "slot", "kind": "value", "type": "string", "required": false, "source": "propertyOrConnection" }
  ],
  "outputs": [
    { "id": "saved", "kind": "exec" },
    { "id": "failed", "kind": "exec" },
    { "id": "error", "kind": "value", "type": "string" }
  ],
  "properties": [
    { "id": "slot", "type": "string", "required": false, "defaultValue": "" }
  ],
  "tags": ["persistence", "save", "variables", "disk"]
}
