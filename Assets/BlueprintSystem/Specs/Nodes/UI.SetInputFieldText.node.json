{
  "schemaVersion": "0.1",
  "typeId": "UI.SetInputFieldText",
  "title": "Set Input Field Text",
  "category": "UI",
  "description": "Sets text on a bound TMP_InputField, without notifying listeners by default.",
  "executor": "UI.SetInputFieldText",
  "inputs": [
    { "id": "execIn", "kind": "exec" },
    { "id": "target", "kind": "value", "type": "Binding<TMP_InputField>", "required": true, "source": "property" },
    { "id": "value", "kind": "value", "type": "string", "required": true, "source": "propertyOrConnection" },
    { "id": "notify", "kind": "value", "type": "bool", "required": false, "source": "propertyOrConnection" }
  ],
  "outputs": [
    { "id": "execOut", "kind": "exec" }
  ],
  "properties": [
    { "id": "target", "type": "Binding<TMP_InputField>", "required": true },
    { "id": "value", "type": "string", "required": false, "defaultValue": "" },
    { "id": "notify", "type": "bool", "required": false, "defaultValue": false }
  ],
  "tags": ["ui", "input", "text", "note", "tmp"]
}
